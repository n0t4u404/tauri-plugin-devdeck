{
	"name": "tauri-plugin-devdeck",
	"version": "1.0.0",
	"description": "JavaScript API of tauri-plugin-devdeck: page reports, resource counters and the hotkey.",
	"license": "MIT",
	"author": "n0t4u404",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/n0t4u404/tauri-plugin-devdeck.git"
	},
	"keywords": [
		"tauri",
		"tauri-plugin",
		"devtools",
		"memory",
		"profiling"
	],
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsc -p .",
		"build:ui": "tsc -p ui && vite build --config ui/vite.config.ts",
		"dev:ui": "vite --config ui/vite.config.ts",
		"prepare": "npm run build",
		"prepublishOnly": "npm run build"
	},
	"peerDependencies": {
		"@tauri-apps/api": "^2.0.0"
	},
	"devDependencies": {
		"@emotion/react": "^11.14.0",
		"@emotion/styled": "^11.14.1",
		"@fontsource-variable/inter": "^5.3.0",
		"@mui/material": "^9.5.0",
		"@mui/x-charts": "^9.16.0",
		"@tauri-apps/api": "^2.0.0",
		"@types/node": "^22.20.5",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^4.7.0",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"typescript": "^5.8.2",
		"vite": "^5.4.21",
		"vite-plugin-singlefile": "^2.3.4"
	}
}
